# Shared styles for Assistant screens.

style app_text:
    color "#e8edf2"
    size 22

style app_small:
    color "#aeb8c2"
    size 16

style app_button:
    background "#263746"
    hover_background "#36546a"
    padding (14, 8)

style app_button_text:
    color "#e8edf2"
    hover_color "#ffffff"
    size 20

style app_title:
    color "#e8edf2"
    size 34
    bold True

style app_message:
    color "#f2f5f8"
    size 24
    textalign 0.0
